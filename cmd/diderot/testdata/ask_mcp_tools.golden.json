{
  "root_mcp_tools": [],
  "investigate_tool": {
    "name": "investigate_observability",
    "description": "Hand a question about live telemetry to a separate investigator that has read-only Sentry and Grafana, Prometheus, Loki, Tempo, and Pyroscope tools. Use it for questions about Sentry issues and events or metrics, logs, traces, profiles, alerts, dashboards, and panels, which cannot be answered from memory or from discussion in the corpus. The investigator works for up to a few minutes and returns one report: what it observed, what it infers, and what it could not establish. The report may list the artifact IDs of Grafana panels it rendered; name those IDs in the final artifacts field when the images belong with your answer. It can run in the same round as corpus tools. If it fails, the error says so: answer from the evidence you have, or delegate a narrower request. A report cut short by the time limit says what it did not get to under Remaining uncertainty.",
    "parameters": {
      "properties": {
        "request": {
          "minLength": 1,
          "description": "The investigation to carry out, written to stand alone: the investigator sees nothing of this conversation. Name the service and the symptom, give every relevant URL, ID, dashboard, namespace, route or error string exactly, give the time window, and say what a useful answer would contain.",
          "type": "string"
        },
        "time_window_utc": {
          "properties": {
            "from": {
              "description": "Start of the window, inclusive: an RFC 3339 UTC time or a relative expression such as now-6h.",
              "type": "string"
            },
            "to": {
              "description": "End of the window, inclusive: an RFC 3339 UTC time or now.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "description": "The UTC window to investigate, when the asker gave one. When they gave none, leave it unset and say in request what period matters.",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "type": "object"
    }
  },

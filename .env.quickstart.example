# Optional settings for the Docker Compose quickstart (docs/quickstart.md).
#   cp .env.quickstart.example .env
# Compose reads .env from the directory you run it in; it is gitignored.
# Nothing here is required: model providers and their keys, sources and
# tools are set up in the admin UI.

# Lets a bare `docker compose ...` use the quickstart stack.
COMPOSE_FILE=compose.quickstart.yaml

# The host port the API and admin UI listen on, on 127.0.0.1 only. Change it
# if 9091 is taken.
DIDEROT_QUICKSTART_PORT=9091

# The email of the API token's identity. Use the email of your Slack account
# if you add Slack, so private channels you share with the bot are visible.
DIDEROT_QUICKSTART_EMAIL=admin@example.com

# The API token, the key that seals browser sessions, and the key that
# encrypts connector secrets are generated on the first start and kept in
# the stack's keys volume. Print the token with
#   docker compose run --rm init cat /keys/api-token
# To use your own instead, set them here: the token from openssl rand -hex 32,
# each key from openssl rand -base64 32.
# DIDEROT_QUICKSTART_TOKEN=
# DIDEROT_BROWSER_SESSION_KEYS=
# DIDEROT_CONFIG_KEYS=

# A different model for the local embedder. Set both lines: the revision is
# a commit of the model's Hugging Face repository. Offer the same model ID
# on the embedder's provider in the admin UI. BAAI/bge-m3 (multilingual, 8k-token context) needs far more
# memory than the default model's 3 GB: a 6 GB Docker VM is not enough.
# DIDEROT_QUICKSTART_EMBED_MODEL=BAAI/bge-m3
# DIDEROT_QUICKSTART_EMBED_REVISION=5617a9f61b028005a4858fdac845db406aefb181

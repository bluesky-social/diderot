{
  "$schema": "https://opencode.ai/config.json",
  // models I like
  "model": "provider/model",
  "mcp": {
    "local-tool": { "type": "local", "command": ["tool"] },
    "diderot": {
      "oauth": {
        "clientId": "public-client",
        "redirectUri": "http://127.0.0.1:19876/callback"
      },
      "type": "remote",
      "url": "https://gateway.example.com/mcp"
    }
  },
}

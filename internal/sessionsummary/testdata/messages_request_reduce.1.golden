{"max_tokens":4096,"messages":[{"content":[{"text":"\u003cchunk_summaries\u003e\n  \u003cchunk index=\"1\"\u003e\n    \u003cevidence\u003e\n      - internal/a.go\n      - go test ./...\n    \u003c/evidence\u003e\n    \u003csummary\u003eFirst part: \"quoted\" \u003ctag\u003e \u0026 more.\u003c/summary\u003e\n  \u003c/chunk\u003e\n  \u003cchunk index=\"2\"\u003e\n    \u003cevidence\u003e\n      - error: boom\n    \u003c/evidence\u003e\n    \u003csummary\u003eSecond part — unicode ✓.\u003c/summary\u003e\n  \u003c/chunk\u003e\n  \u003cchunk index=\"1-2\"\u003e\n    \u003cevidence\u003e\n      - earlier\n    \u003c/evidence\u003e\n    \u003csummary\u003eAn earlier summary standing in for parts.\u003c/summary\u003e\n  \u003c/chunk\u003e\n\u003c/chunk_summaries\u003e","type":"text"}],"role":"user"}],"model":"claude-sonnet-5","system":[{"text":"Combine the part summaries into one.\nUnicode: naïve — 日本語.","cache_control":{"type":"ephemeral"},"type":"text"}],"tool_choice":{"name":"record_session_summary","disable_parallel_tool_use":true,"type":"tool"},"tools":[{"input_schema":{"type":"object","properties":{"context_hint":{"description":"One short line (\u003c150 chars) naming the session's subject. Format: '\u003crepo\u003e: \u003csubsystem\u003e; \u003cone or two key nouns\u003e'. Used as a contextual prefix prepended to each chunk during embedding.","type":"string"},"embedding_text":{"description":"A 250–500 character keyword-dense version of the summary, optimized for last-token-pooling embedding. Front-load proper nouns; drop filler. End with a 'Topic:' line listing the 3–5 most important nouns.","type":"string"},"evidence":{"description":"3 to 5 verbatim strings that recur across chunks and ground the narrative.","items":{"type":"string"},"maxItems":5,"minItems":3,"type":"array"},"narrative":{"description":"A 900–1800 character narrative of the whole session: goal, pivots, outcome. Names concrete proper nouns. Weights early and mid session equally with the tail.","type":"string"},"tags":{"properties":{"activities":{"description":"Kinds of work being done. Closed vocabulary.","items":{"enum":["debug","implement","refactor","test","review","investigate","document","deploy","provision","configure","incident","design","backfill","cleanup"],"type":"string"},"type":"array"},"freeform":{"description":"Up to 3 short tags for concepts not covered by the enums: features, subsystems, third-party services, infra components.","items":{"type":"string"},"maxItems":3,"type":"array"},"languages":{"description":"Programming languages worked with in the session. Closed vocabulary.","items":{"enum":["go","python","typescript","javascript","rust","sql","bash","yaml","terraform","pulumi","dockerfile","html","css","markdown","json","protobuf"],"type":"string"},"type":"array"},"projects":{"description":"Repo or project names drawn from the evidence. Canonical form (\"diderot\" not \"the diderot project\").","items":{"type":"string"},"type":"array"}},"required":[],"type":"object"}},"required":["evidence","narrative","embedding_text","context_hint","tags"]},"name":"record_session_summary","description":"Record the final session summary. Call this exactly once, then stop."}]}